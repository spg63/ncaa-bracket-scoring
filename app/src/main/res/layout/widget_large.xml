<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:clipToOutline="true">

    <!-- ── Orange header ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#BF360C"
        android:paddingStart="10dp"
        android:paddingEnd="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bracket Scores"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Generous padding so it doesn't compete with stack scroll gestures -->
        <TextView
            android:id="@+id/widget_mode_label"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="TRAD"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_mode_pill" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── Player rows ───────────────────────────────────────────────────── -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row1_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#1"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#F57F17" />
        <TextView
            android:id="@+id/row1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row1_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#18000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row2_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#2"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#9E9E9E" />
        <TextView
            android:id="@+id/row2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row2_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#18000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row3_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#3"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#8D6E63" />
        <TextView
            android:id="@+id/row3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row3_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#18000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row4_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#4"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#534340" />
        <TextView
            android:id="@+id/row4_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row4_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#18000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row5_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#5"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#534340" />
        <TextView
            android:id="@+id/row5_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row5_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#18000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/row6_rank"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="#6"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#534340" />
        <TextView
            android:id="@+id/row6_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#201A19"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/row6_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#BF360C" />
    </LinearLayout>

    <!-- ── Footer ────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:text=""
        android:textSize="11sp"
        android:textColor="#85736F"
        android:background="#0C000000" />

</LinearLayout>
